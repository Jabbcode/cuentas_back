DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cuentas_db?schema=public"
JWT_SECRET="change-this-to-a-secure-secret-key"
PORT=3001
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="MisCuentas <noreply@miscuentas.app>"
# APP_ENV: entorno lógico del servicio — production | pre | pre-test | development.
# Solo alimenta el campo `environment` de GET /api/version; no afecta al CORS.
APP_ENV="development"
# CORS_ORIGIN: lista EXACTA de orígenes permitidos, separados por comas (sin
# comodines ni patrones). Obligatorio en todos los entornos — sin él no se
# permite ningún origen. En local, el dev server de Vite:
CORS_ORIGIN="http://localhost:5173"
