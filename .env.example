DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cuentas_db?schema=public"
JWT_SECRET="change-this-to-a-secure-secret-key"
PORT=3001
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="MisCuentas <noreply@miscuentas.app>"
# APP_ENV: entorno lógico del servicio — production | pre | pre-test | development.
# En pre/pre-test habilita además el alias de preview de Vercel en CORS.
APP_ENV="development"
# CORS_ORIGIN: lista de orígenes exactos permitidos, separados por comas.
# En local, el dev server de Vite:
CORS_ORIGIN="http://localhost:5173"
